# Copy this file to .env, then fill in ONE of the options below.

# FREE + LOCAL (recommended): Ollama. Install from https://ollama.com, run
#   ollama pull qwen3:8b
# then keep this line. No key, no internet, student data stays on your computer.
EDUPATH_PROVIDER=ollama
# EDUPATH_OLLAMA_MODEL=qwen3:8b          # or llama3.1:8b, qwen3:4b (faster), qwen3:14b (better, needs ~12 GB RAM)

# FREE cloud option: Google Gemini (free tier isn't available for every Google project).
# Get a key at https://aistudio.google.com/apikey and set EDUPATH_PROVIDER=gemini
# GEMINI_API_KEY=

# Paid option: Anthropic Claude. Get a key at https://console.anthropic.com and set EDUPATH_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Optional settings
# EDUPATH_PROVIDER: ollama | gemini | claude | offline (if unset: whichever API key exists, else offline)
# EDUPATH_GEMINI_MODEL=gemini-3.8-flash
# EDUPATH_GEMINI_MIN_INTERVAL=4        # seconds between Gemini calls (free-tier rate limit)
# EDUPATH_CLAUDE_MODEL=claude-opus-5-5
